  "license": "ISC",
  "dependencies": {
    "@langchain/core": "^1.4.0",
    "@langchain/langgraph": "^1.7.3",
    "@langchain/openai": "^1.8.4",
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
