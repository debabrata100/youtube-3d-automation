{
  "name": "orchestrator",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "assets:demo": "node --import tsx src/assets/generateDemo.ts",
    "test": "node --import tsx --test test/unit.test.ts test/planning.test.ts test/mascot.test.ts test/inspection.test.ts test/wolf.test.ts test/controller.test.ts test/polish.test.ts test/performance.test.ts test/sceneDirector.test.ts test/forwardWave.test.ts",
    "test:wave": "node --import tsx --test test/forwardWave.integration.test.ts",
    "test:integration": "node --import tsx --test test/integration.test.ts",
    "plan": "node --import tsx src/plan.ts",
    "assets:mascot": "node --import tsx src/assets/generateMascot.ts",
    "assets:validate": "node --import tsx src/assets/importAsset.ts",
    "render:plan": "node --import tsx src/renderPlan.ts",
    "test:mascot": "node --import tsx --test test/mascot.integration.test.ts",
    "assets:inspect": "node --import tsx src/assets/inspectCharacter.ts",
    "test:inspection": "node --import tsx --test test/inspection.integration.test.ts",
    "wolf:review": "node --import tsx src/wolfReview.ts",
    "test:wolf": "node --import tsx --test test/wolf.integration.test.ts",
    "wolf:motion-review": "node --import tsx src/wolfMotionReview.ts",
    "test:controller": "node --import tsx --test test/controller.integration.test.ts",
    "wolf:polish-review": "node --import tsx src/wolfPolishReview.ts",
    "test:polish": "node --import tsx --test test/polish.integration.test.ts",
    "wolf:performance-review": "node --import tsx src/wolfPerformanceReview.ts",
    "test:performance": "node --import tsx --test test/performance.integration.test.ts",
    "wolf:interaction-review": "node --import tsx src/wolfInteractionReview.ts",
    "test:interaction": "node --import tsx --test test/interaction.integration.test.ts"
  },
  "keywords": [],
